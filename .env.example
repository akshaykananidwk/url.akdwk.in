# ------------------------------------------------------------------
# Shortl — environment configuration
# The web installer at /install fills this in automatically.
# You normally never need to edit this file by hand.
# ------------------------------------------------------------------

APP_NAME=Shortl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Set true to require a purchase code during installation
INSTALL_REQUIRE_LICENSE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database — mysql (recommended) or sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shortl
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# Sessions & cache: file works everywhere; use redis for high traffic
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file

# Queue: 'sync' records clicks in-process (no worker needed) — best for most
# self-hosted setups. For very high traffic switch to 'database' or 'redis'
# and run a worker: php artisan queue:work
QUEUE_CONNECTION=sync

# Redis (optional — set CACHE_STORE=redis and QUEUE_CONNECTION=redis to use)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail fallback — normally configured from Admin → Settings → Email (SMTP)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem — file uploads default to local; S3 configured from admin panel
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
